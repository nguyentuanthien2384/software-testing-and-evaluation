{
  "name": "n01-g11-complete-project-qa",
  "version": "4.0.0",
  "private": true,
  "scripts": {
    "test": "npm --prefix source/teacher-payroll-app test --",
    "app:install": "npm install --prefix source/teacher-payroll-app",
    "app:dev": "npm run dev --prefix source/teacher-payroll-app",
    "app:build": "npm run build --prefix source/teacher-payroll-app",
    "test:unit": "npm --prefix source/teacher-payroll-app run test:unit --",
    "test:integration": "npm --prefix source/teacher-payroll-app run test:integration --",
    "typecheck": "npm --prefix source/teacher-payroll-app run typecheck",
    "qa:check": "npm run typecheck && npm run coverage -- --runInBand && npm run test:jmeter-checker",
    "test:jmeter-checker": "node --test tests/jmeter/check-thresholds.test.mjs",
    "test:jmeter-assertions": "node --test tests/jmeter/payroll-assertions.integration.test.mjs",
    "test:sqlite-evidence": "python evidence/db-sqlite/verify_sqlite.py --check-only",
    "coverage": "npm --prefix source/teacher-payroll-app run coverage --",
    "yc7:install": "npm install --prefix tests/selenium-js",
    "yc7:test": "npm run test:junit --prefix tests/selenium-js",
    "yc8:test": "bash tests/jmeter/run-yc8.sh",
    "qa:yc7-yc8": "bash scripts/run-yc7-yc8.sh"
  }
}
