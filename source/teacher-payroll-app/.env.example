# Cơ sở dữ liệu SQLite cho Prisma (YC2)
DATABASE_URL="file:./dev.db"

# Bắt buộc đổi thành chuỗi ngẫu nhiên riêng, tối thiểu 32 ký tự khi chạy production.
AUTH_SESSION_SECRET="change-this-secret"

# Có thể đổi mật khẩu demo mà không sửa mã nguồn.
ADMIN_PASSWORD="admin@123"
TESTER_PASSWORD="tester@123"
